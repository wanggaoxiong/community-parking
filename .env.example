# ==============================================================================
# 邻里停 (Community Parking) Ubuntu 24.04 & Cloudflare 环境变量配置模板
# 使用方式: 在 Ubuntu 服务器上执行 cp .env.example .env 后按需填入 Token
# ==============================================================================

# 1. 您的 Cloudflare 公网子域名 (对应 listingworker.com，已内置全套 Apple 预签名快捷指令包)
PUBLIC_MOBILE_URL=https://parking.listingworker.com
PUBLIC_VOICE_URL=https://voice.listingworker.com

# (备选) 若暂不启用域名、直接通过云主机 IP (40.82.129.122) 测试，可改为:
# PUBLIC_MOBILE_URL=http://40.82.129.122:18790
# PUBLIC_VOICE_URL=http://40.82.129.122:18791

# 2. Cloudflare Tunnel 令牌 (强烈推荐: 免装 Nginx/SSL、免开云安全组端口、Spot 换 IP 自动重连)
# 在 https://one.dash.cloudflare.com -> Networks -> Tunnels 新建隧道并映射:
#   parking.listingworker.com -> http://community-parking:18790
#   voice.listingworker.com   -> http://community-parking:18791
CLOUDFLARE_TUNNEL_TOKEN=

# 3. 端口绑定设置 (:8790 管理台默认仅绑定 127.0.0.1，通过 ssh -L 8790:127.0.0.1:8790 ericwang@40.82.129.122 安全访问)
PARKING_ADMIN_BIND=127.0.0.1
PARKING_PORT=8790
PARKING_MOBILE_PORT=18790
PARKING_VOICE_PORT=18791
PARKING_FTP_PORT=2121

# 4. 可选全局默认访问口令 (留空免口令；也可在 :8790 右上角按不同小区 Workspace 独立设置口令)
VOICE_GATEWAY_TOKEN=

# 5. GitHub Container Registry (GHCR) 自动热更镜像源与轮询间隔 (秒)
# 跨 GitHub 账号迁移时，仅需将下方 wanggaoxiong 改为新账号名(全小写)即可无缝衔接！
PARKING_IMAGE=ghcr.io/wanggaoxiong/community-parking:latest
WATCHTOWER_POLL_INTERVAL=300

